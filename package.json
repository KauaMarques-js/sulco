  "update-data": "node --experimental-strip-types scripts/update-data.mjs",
  "test:firms": "node --experimental-strip-types test/firms.test.ts",
  "test:api": "node --experimental-strip-types test/api.test.ts",
  "test:oceans": "node --experimental-strip-types test/oceans.test.ts",
  "test:performance": "node --experimental-strip-types test/performance.test.ts",
  "test:svs": "node --experimental-strip-types test/svs.test.ts",
